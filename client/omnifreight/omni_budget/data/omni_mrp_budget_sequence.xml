<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Prefix distinguishes this from trading_budget's own budget sequence
         (TRD/BUD/) now that both verticals can be installed in the same
         database: the two are independent counters (different `code`, so
         no functional collision), but a shared "BUD" prefix made two
         unrelated budgets render identically in the UI. -->
    <record id="seq_omni_mrp_budget" model="ir.sequence">
        <field name="name">Manufacturing Order Budget</field>
        <field name="code">omni.mrp.budget</field>
        <field name="prefix">FRT/BUD/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

