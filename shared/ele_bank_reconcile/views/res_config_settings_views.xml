<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_reconcile_config_settings" model="ir.ui.view">
        <field name="name">Bank Reconciliation Settings</field>
        <field name="model">res.config.settings</field>
        <field name="priority">96</field>
        <field name="arch" type="xml">
            <form string="Bank Reconciliation Settings" class="o_config_form">
                <sheet>
                    <div class="alert alert-info" role="status" style="margin-bottom:0px;">
                        <p>
                            <i class="fa fa-university"/> How bank statement lines are
                            classified as perfect or partial matches. Each setting falls
                            back to a built-in default when left empty, so an existing
                            database keeps its current behaviour until you configure it.
                        </p>
                    </div>

                    <group string="Match Classification">
                        <field name="ele_tolerance_account_ids" widget="many2many_tags"/>
                        <field name="ele_bank_charge_patterns"
                               placeholder="One regular expression per line, e.g. bank\s*charge"/>
                        <field name="ele_internal_transfer_keywords"
                               placeholder="One keyword per line, e.g. internal transfer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_reconcile_config_settings" model="ir.actions.act_window">
        <field name="name">Bank Reconciliation Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bank_reconcile_config_settings"/>
        <field name="target">new</field>
        <field name="context">{'module': 'ele_bank_reconcile'}</field>
    </record>

    <menuitem id="menu_bank_reconcile_settings"
              name="Bank Reconciliation"
              parent="base.menu_administration"
              action="action_bank_reconcile_config_settings"
              sequence="102"/>
</odoo>
