<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_budget_role" model="res.groups.privilege">
        <field name="name">Budget Role</field>
        <field name="category_id" ref="trading.module_category_trading"/>
    </record>

    <record id="group_budget_user" model="res.groups">
        <field name="name">Budget User</field>
        <field name="privilege_id" ref="privilege_budget_role"/>
        <field name="comment">Can create and manage trade budgets, but not delete them.</field>
    </record>

    <record id="group_budget_manager" model="res.groups">
        <field name="name">Budget Manager</field>
        <field name="privilege_id" ref="privilege_budget_role"/>
        <field name="implied_ids" eval="[(4, ref('group_budget_user'))]"/>
        <field name="comment">Full control over trade budgets, including deletion.</field>
    </record>
</odoo>
