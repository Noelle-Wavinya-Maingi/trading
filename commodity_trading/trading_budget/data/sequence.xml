<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Trade Budgets. Moved here from trading/data/sequence.xml: the
             sequence is only ever consumed by this module
             (trading_trade_budget.py's next_by_code('trading.budget')), so it
             belongs with its actual consumer rather than in core trading,
             which has no use for it when trading_budget isn't installed.

             Prefix distinguishes it from omni_budget's own budget sequence
             (FRT/BUD/) now that both verticals can be installed in the same
             database: the two are independent counters (different `code`,
             so no functional collision), but a shared "BUD" prefix made two
             unrelated budgets render identically in the UI. -->
        <record id="seq_trading_budget" model="ir.sequence">
            <field name="name">Trade Budget</field>
            <field name="code">trading.budget</field>
            <field name="prefix">TRD/BUD/</field>
            <field name="padding">5</field>
        </record>

    </data>
</odoo>
