<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_trading" model="ir.module.category">
        <field name="name">Trading</field>
    </record>

    <!-- Odoo 19 groups a res.groups record under a category via an
         intermediate res.groups.privilege, not category_id directly. -->
    <record id="privilege_trading_role" model="res.groups.privilege">
        <field name="name">Trading Role</field>
        <field name="category_id" ref="module_category_trading"/>
    </record>

    <record id="group_trading_trader" model="res.groups">
        <field name="name">Trader</field>
        <field name="privilege_id" ref="privilege_trading_role"/>
        <field name="comment">Can create and manage trades, but not delete them.</field>
    </record>

    <record id="group_trading_manager" model="res.groups">
        <field name="name">Trading Manager</field>
        <field name="privilege_id" ref="privilege_trading_role"/>
        <field name="implied_ids" eval="[(4, ref('group_trading_trader'))]"/>
        <field name="comment">Full control over trades, including deletion.</field>
    </record>
</odoo>
