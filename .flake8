[flake8]
max-line-length = 120
extend-ignore = E501, W503, W504
exclude = .git,__pycache__,migrations
# __init__.py files re-export models/tests purely for their side effect of
# registering with Odoo -- that's the standard Odoo pattern, not a real
# unused import.
per-file-ignores =
    __init__.py:F401
