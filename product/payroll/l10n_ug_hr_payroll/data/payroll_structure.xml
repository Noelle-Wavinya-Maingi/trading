<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="structure_type_employee" model="hr.payroll.structure.type">
        <field name="name">Uganda: Employee</field>
        <field name="country_id" ref="base.ug" />
        <field name="default_schedule_pay">monthly</field>
        <field name="wage_type">monthly</field>
        <field name="default_work_entry_type_id" ref="hr_work_entry.work_entry_type_attendance" />
    </record>

    <record id="structure_monthly" model="hr.payroll.structure">
        <field name="name">Uganda: Regular Monthly Pay</field>
        <field name="code">ELE_UG_MONTHLY</field>
        <field name="country_id" ref="base.ug"></field>
        <field name="type_id" ref="structure_type_employee" />
        <field name="report_id" ref="hr_payroll.action_report_payslip" />
        <field name="note">Resident employee monthly payroll for July 2026 through June 2027.</field>
    </record>

    <record id="structure_type_employee" model="hr.payroll.structure.type">
        <field name="default_struct_id" ref="structure_monthly" />
    </record>
</odoo>