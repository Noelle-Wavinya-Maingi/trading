<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_uganda_payroll" model="ir.ui.view">
        <field name="name">hr.employee.form.uganda.payroll</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id"
               ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">
            <group name="payroll_group" position="inside">
                <field name="company_country_code" invisible="1"/>

                <group string="Uganda Payroll"
                       invisible="company_country_code != 'UG'">
                    <field name="ele_ug_tin"/>
                    <field name="ele_ug_nssf_number"/>
                    <field name="ele_ug_tax_treatment"
                           required="company_country_code == 'UG'"/>
                    <field name="ele_ug_nssf_status"
                           required="company_country_code == 'UG'"/>
                    <field name="ele_ug_nssf_exemption_reason"
                           invisible="ele_ug_nssf_status != 'exempt'"
                           required="ele_ug_nssf_status == 'exempt'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>