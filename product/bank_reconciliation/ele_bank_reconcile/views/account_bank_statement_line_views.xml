<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Bank reconciliation itself is an Enterprise-only workflow (account_accountant);
        Community ships no UI at all to reconcile a statement line, so this module
        depends on account_accountant rather than pretending to be Community-standalone.
    -->

    <!--
        The Bank Matching widget's kanban view only requests the fields its OWL
        component (BankRecStatementLine) needs. ele_match_quality has to be added
        to that field list before static/src/xml/statement_line.xml can read it
        off recordData to recolour the "Reconciled" badge.
    -->
    <record id="view_bank_statement_line_kanban_bank_rec_widget_ele_match_quality" model="ir.ui.view">
        <field name="name">account.bank.statement.line.kanban.bank_rec_widget.ele_match_quality</field>
        <field name="model">account.bank.statement.line</field>
        <field name="inherit_id" ref="account_accountant.view_bank_statement_line_kanban_bank_rec_widget"/>
        <field name="arch" type="xml">
            <field name="is_reconciled" position="after">
                <field name="ele_match_quality"/>
            </field>
        </field>
    </record>
</odoo>
