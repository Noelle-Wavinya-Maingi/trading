<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trading_futures_tree" model="ir.ui.view">
        <field name="name">trading.futures.list</field>
        <field name="model">trading.futures</field>
        <field name="arch" type="xml">
            <list>
                <!-- <field name="name"/> -->
                <field name="ele_trade_id"/>
                
                <field name="ele_contract_quantity" string="Quantity"/>
                <field name="ele_product_uom" nolabel="1" />
                <field name="ele_contract_price"/>
                <field name="ele_closed_balance"/>
                <field name="ele_open_balance"/>
                <field name="ele_closed_sales_value" sum="Total Sales"/>
                <!-- <field name="ele_net_value" sum="Total Net Value"/> -->
                <field name="ele_realized_pnl" sum="Total Realized"/>
                <field name="ele_status" widget="badge" decoration-success="ele_status == 'closed'" decoration-info="ele_status == 'open'" />
            </list>
        </field>
    </record>

    <record id="view_trading_futures_form" model="ir.ui.view">
        <field name="name">trading.futures.form</field>
        <field name="model">trading.futures</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="ele_status" widget="statusbar" options="{'clickable': False}" />
                </header>
                <sheet>
                    <h1>
                        <field name="name" nolabel="1"  default_focus="1" />
                    </h1>
                    <group string="Contract Details">
                        <group>
                            <field name="ele_trade_id" readonly="ele_status == 'closed'"/>
                            <field name="ele_open_date" readonly="ele_status == 'closed'"/>
                            <field name="ele_close_date" readonly="ele_status == 'closed'"/>
                        </group>
                        <group>
                            <field name="ele_contract_type" readonly="ele_status == 'closed'"/>
                            <label for="ele_contract_quantity" string="Contract Quantity" />
                            <div class="o_row g-0 d-flex">
                            <field name="ele_contract_quantity" readonly="ele_status == 'closed'"/>
                            <field name="ele_product_uom" />
                            </div>
                            <field name="currency_id"  invisible="1" />
                            <field name="ele_contract_price" widget="monetary" readonly="ele_status == 'closed'" />
                            <field name="ele_current_price" invisible="ele_status == 'closed'"/>
                        </group>
                    </group>
                    
                    <group string="Balances">
                        <group>
                            <label for="ele_closed_balance" string="Closed Balance" />
                            <div class="o_row g-0 d-flex">
                            <field name="ele_closed_balance"/>
                            <field name="ele_product_uom" />
                            </div>
                            <label for="ele_open_balance" string="Open Balance" />
                            <div class="o_row g-0 d-flex">
                            <field name="ele_open_balance"/>
                            <field name="ele_product_uom" />
                            </div>
                        </group>
                        <group>
                            <field name="ele_closed_value_at_contract" widget="monetary"/>
                            <field name="ele_open_value_at_contract" widget="monetary"/>
                            <field name="ele_total_contract_value" widget="monetary"/>
                        </group>
                    </group>
                    
                    <group string="Valuation">
                        <group>
                            <field name="ele_closed_sales_value" widget="monetary"/>
                            <field name="ele_net_value" widget="monetary"/>
                        </group>
                        <group>
                            <field name="ele_realized_pnl" widget="monetary"/>
                            <field name="ele_unrealized_pnl" widget="monetary" />
                            <!-- <field name="ele_unrealized_pnl"/>
                            <field name="ele_total_pnl"/> -->
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
</odoo>