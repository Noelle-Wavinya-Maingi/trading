<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_purchase_order_form_trading" model="ir.ui.view">
            <field name="name">purchase.order.form.trading</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="ele_trade_id" domain="[('ele_status', '=', 'confirmed')]" readonly="state in ['purchase', 'done']" groups="ele_trading.group_trading_trader,ele_trading.group_trading_manager" />
                </xpath>

            </field>
        </record>

    </data>
</odoo>