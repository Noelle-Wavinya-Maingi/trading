<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Budget Form View -->
    <record id="trading_trade_budget_form" model="ir.ui.view">
        <field name="name">trading.trade.budget.form</field>
        <field name="model">trading.trade.budget</field>
        <field name="arch" type="xml">
            <form string="Trade Budget">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object"
                            class="btn-secondary" invisible="state not in ('confirmed',)"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,closed"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="ele_trade_id" readonly="1"/>
                            <field name="ele_trade_type" invisible="1"/>
                            <field name="ele_is_fully_matched" invisible="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="ele_analytic_account_id"/>
                        </group>
                    </group>

                    <!-- Cumulative Summary -->
                    <div class="row mt-3 mb-3">
                        <div class="col-12 col-lg-6">
                            <div class="card o_trading_card_red">
                                <div class="card-header o_trading_card_header_red">
                                    <h5><i class="fa fa-arrow-circle-down"/> Cost</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-2">
                                        <div class="col-6 text-center">
                                            <span class="o_trading_kpi_label o_trading_kpi_label_bold" invisible="ele_trade_type != 'long'">Budgeted Cost</span>
                                            <span class="o_trading_kpi_label o_trading_kpi_label_bold" invisible="ele_trade_type == 'long'">Target Cost</span>
                                            <field name="ele_total_budgeted_cost" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            <span class="o_trading_kpi_note">
                                                Budgeted = actively costed/priced side. Target = other side, back-solved from target margin.
                                            </span>
                                        </div>
                                        <div class="col-6 text-center">
                                            <strong class="o_trading_kpi_label">Actual Cost</strong>
                                            <field name="ele_actual_cost" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                        </div>
                                        <div class="col-12 text-center mt-2">
                                            <span invisible="not ele_is_fully_matched" class="o_trading_kpi_label o_trading_kpi_label_bold">Cost Variance</span>
                                            <field name="ele_cost_variance" widget="monetary" readonly="1" nolabel="1"
                                                   class="fw-bold"
                                                   invisible="not ele_is_fully_matched"
                                                   decoration-success="ele_cost_variance &lt;= 0"
                                                   decoration-danger="ele_cost_variance &gt; 0"/>
                                            <span invisible="ele_is_fully_matched" class="o_trading_kpi_note">
                                                Trade still open — variance not yet meaningful
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6">
                            <div class="card o_trading_card_green o_trading_mb1">
                                <div class="card-header o_trading_card_header_green">
                                    <h5><i class="fa fa-arrow-circle-up"/> Revenue</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-2">
                                        <div class="col-6 text-center">
                                            <span class="o_trading_kpi_label o_trading_kpi_label_bold" invisible="ele_trade_type != 'short'">Budgeted Revenue</span>
                                            <span class="o_trading_kpi_label o_trading_kpi_label_bold" invisible="ele_trade_type == 'short'">Target Revenue</span>
                                            <field name="ele_total_budgeted_revenue" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                            <span class="o_trading_kpi_note">
                                                Budgeted = actively costed/priced side. Target = other side, back-solved from target margin.
                                            </span>
                                        </div>
                                        <div class="col-6 text-center">
                                            <strong class="o_trading_kpi_label">Actual Revenue</strong>
                                            <field name="ele_actual_revenue" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                        </div>
                                        <div class="col-12 text-center mt-2">
                                            <span invisible="not ele_is_fully_matched" class="o_trading_kpi_label o_trading_kpi_label_bold">Revenue Variance</span>
                                            <field name="ele_revenue_variance" widget="monetary" readonly="1" nolabel="1"
                                                   class="fw-bold"
                                                   invisible="not ele_is_fully_matched"
                                                   decoration-success="ele_revenue_variance &gt;= 0"
                                                   decoration-danger="ele_revenue_variance &lt; 0"/>
                                            <span invisible="ele_is_fully_matched" class="o_trading_kpi_note">
                                                Trade still open — variance not yet meaningful
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3 o_trading_card_purple o_trading_mb1">
                        <div class="card-header o_trading_card_header_purple">
                            <h5 class="mb-0"><i class="fa fa-bullseye me-1"/> Margin Target</h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col text-center">
                                    <strong class="o_trading_kpi_label">Target Margin %</strong>
                                    <field name="ele_target_margin_percent" readonly="1" nolabel="1" class="fw-bold"/>
                                </div>
                                <div class="col text-center">
                                    <strong class="o_trading_kpi_label">Target P&amp;L</strong>
                                    <field name="ele_target_pnl" widget="monetary" readonly="1" nolabel="1" class="fw-bold"/>
                                </div>
                                <div class="col text-center">
                                    <strong class="o_trading_kpi_label">Total P&amp;L</strong>
                                    <field name="ele_total_pnl" widget="monetary" readonly="1" nolabel="1" class="fw-bold"
                                           decoration-success="ele_total_pnl &gt; 0" decoration-danger="ele_total_pnl &lt; 0"/>
                                </div>
                                <div class="col text-center">
                                    <span invisible="not ele_is_fully_matched" class="o_trading_kpi_label o_trading_kpi_label_bold">P&amp;L Variance</span>
                                    <field name="ele_margin_pnl_variance" widget="monetary" readonly="1" nolabel="1" class="fw-bold"
                                           invisible="not ele_is_fully_matched"
                                           decoration-success="ele_margin_pnl_variance &gt; 0" decoration-danger="ele_margin_pnl_variance &lt; 0"/>
                                    <span invisible="ele_is_fully_matched" class="o_trading_kpi_note">not yet meaningful</span>
                                </div>
                                <div class="col text-center">
                                    <span invisible="not ele_is_fully_matched" class="o_trading_kpi_label o_trading_kpi_label_bold">P&amp;L Variance %</span>
                                    <field name="ele_margin_pnl_variance_percent" readonly="1" nolabel="1" class="fw-bold"
                                           invisible="not ele_is_fully_matched"
                                           decoration-success="ele_margin_pnl_variance_percent &gt; 0" decoration-danger="ele_margin_pnl_variance_percent &lt; 0"/>
                                    <span invisible="ele_is_fully_matched" class="o_trading_kpi_note">not yet meaningful</span>
                                </div>
                            </div>
                        </div>
                    </div><br/>

                    <!-- Budget Lines -->
                     <h4 class="text-center">Additional Costs &amp; Additional Revenue</h4> <hr/>
                    <field name="ele_budget_line_ids" context="{'default_ele_trade_budget_id': id}" readonly="state == 'closed'">
                        <list editable="bottom" create="1" delete="1" string="Budget Lines" decoration-bf="display_type == 'line_section'">
                            <field name="sequence" widget="handle"/>
                            <!-- <field name="display_type" column_invisible="True"/> -->
                            <field name="name" required="1" decoration-bf="display_type == 'line_section'"/>
                            <field name="source_reference" string="Source" invisible="display_type"/>
                            <field name="line_type" required="not display_type" widget="tags" invisible="display_type"/>
                            <field name="partner_id" invisible="display_type"/>
                             <field name="date_actual" optional="hide" string="Date" invisible="display_type"/>
                            <field name="currency_id" column_invisible="True"/>
                            
                            <!-- <field name="section_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="display_type != 'line_section'" class="fw-bold"/> -->
                            
                           
                            <field name="actual_amount" widget="monetary" options="{'currency_field': 'currency_id'}" string="Amount" invisible="display_type"/>
                            <control>
                                <create string="Add a line"/>
                                <!-- <create string="Add a section" context="{'default_display_type': 'line_section'}"/> -->
                            </control>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Budget Tree View -->
    <record id="trading_trade_budget_tree" model="ir.ui.view">
        <field name="name">trading.trade.budget.tree</field>
        <field name="model">trading.trade.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ele_trade_id"/>
                <field name="state" widget="badge" decoration-success="state == 'closed'" decoration-info="state == 'confirmed'"/>
                <field name="currency_id" optional="show"/>
                <field name="ele_total_budgeted_cost" widget="monetary"/>
                <field name="ele_actual_cost" widget="monetary"/>
                <field name="ele_total_budgeted_revenue" widget="monetary"/>
                <field name="ele_actual_revenue" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Budget Action -->
    <record id="action_trading_trade_budget" model="ir.actions.act_window">
        <field name="name">Trade Budgets</field>
        <field name="res_model">trading.trade.budget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a budget from a trade's Budget tab.
            </p>
        </field>
    </record>
</odoo>