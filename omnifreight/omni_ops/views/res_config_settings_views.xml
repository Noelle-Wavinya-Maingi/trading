<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_omni_ops_config_settings" model="ir.ui.view">
        <field name="name">Freight Operations Settings</field>
        <field name="model">res.config.settings</field>
        <field name="priority">95</field>
        <field name="arch" type="xml">
            <form string="Freight Operations Settings" class="o_config_form">
                <sheet>
                    <div class="alert alert-info" role="status" style="margin-bottom:0px;">
                        <p>
                            <i class="fa fa-ship"/> Client-specific defaults for freight
                            operations. Each setting falls back to a built-in default when
                            left empty, so an existing database keeps its current behaviour
                            until you configure it.
                        </p>
                    </div>

                    <group>
                        <group string="Service Products">
                            <field name="omni_service_category_id"/>
                        </group>

                    </group>

                    <group string="Service Workcenters">
                        <div class="text-muted" style="margin-bottom:8px;">
                            Leave empty to fall back to matching a workcenter by name, which
                            is imprecise and may auto-create one. Setting these makes service
                            operation routing deterministic.
                        </div>
                        <group>
                            <field name="omni_fob_workcenter_id"/>
                            <field name="omni_freight_workcenter_id"/>
                            <field name="omni_lod_workcenter_id"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_omni_ops_config_settings" model="ir.actions.act_window">
        <field name="name">Freight Operations Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_omni_ops_config_settings"/>
        <field name="target">new</field>
        <field name="context">{'module': 'omni_ops'}</field>
    </record>

    <menuitem id="menu_omni_ops_settings"
              name="Freight Operations"
              parent="base.menu_administration"
              action="action_omni_ops_config_settings"
              sequence="101"/>
</odoo>
