<odoo>
    <record id="view_omni_ops_file_form_inherit_documents" model="ir.ui.view">
        <field name="name">omni.ops.file.form.documents</field>
        <field name="model">omni.ops.file</field>
        <field name="inherit_id" ref="omni_ops.view_omni_ops_file_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='fob_steps']" position="before">
                <page string="Documents" name="documents">
                    <field name="document_ids" nolabel="1" context="{'default_file_id': id}" options="{'no_create': False, 'no_open': False}">
                        <list>
                            <field name="filename"/>
                            <field name="is_done" widget="boolean_toggle"/>
                            <field name="user_id"/>
                            <field name="upload_date" readonly="1"/>
                            <button name="action_mark_done" type="object" string="Mark Done" invisible="is_done" class="btn btn-sm btn-success"/>
                            <button name="action_mark_undone" type="object" string="Mark Undone" invisible="not is_done" class="btn btn-sm btn-danger"/>
                        </list>
                        <form create="true" edit="true" delete="true">
                            <group>
                                <field name="document_upload" widget="binary" filename="filename"/>
                                <field name="filename" invisible="1"/>
                                <field name="file_id" invisible="1"/>
                                <field name="is_done" widget="boolean_toggle"/>
                                <field name="user_id" readonly="1"/>
                                <field name="upload_date" readonly="1"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
